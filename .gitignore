# Segredos (RF01, seção 13) — o .env.example continua versionado
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Sistema e editores
.DS_Store
.vscode/
.idea/

# Saídas geradas: fora do git no desenvolvimento; a rodada final entra com git add -f
dados/processados/*
resultados/*/*
!dados/processados/.gitkeep
!resultados/*/.gitkeep

# Interface: dependências do Node; o build (interface/dist) é versionado
interface/node_modules/
