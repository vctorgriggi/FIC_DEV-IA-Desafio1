{
  "provedor": "openai",
  "modelos": {
    "texto": "gpt-6.1-terra",
    "transcricao": "gpt-transcribe",
    "visao": "gpt-6.1-terra",
    "tts": "gpt-4o-mini-tts",
    "imagem": "gpt-image-2.5-flare"
  },
  "parametros_geracao": {
    "max_output_tokens": 25000
  },
  "audio": {
    "timeout_inspecao_s": 30,
    "idiomas": ["pt"],
    "voz": "marin",
    "estilo": "Fale em português brasileiro, com tom institucional, claro, sério e acolhedor, em ritmo pausado. Articule nomes, datas e protocolos com clareza. Leia somente o texto fornecido, sem comentários ou acréscimos."
  },
  "timeout_segundos": 180,
  "armazenar_no_provedor": false,
  "precos_usd_por_milhao_tokens": {
    "gpt-6.1-terra": { "entrada": 1.0, "saida": 5.0 },
    "gpt-image-2.5-flare": { "entrada": 5.0, "entrada_imagem": 8.0, "saida": 30.0 }
  },
  "precos_usd_por_minuto_audio": {
    "gpt-transcribe": 0.0045
  },
  "entradas": {
    "texto": { "extensoes": [".txt"], "tamanho_max_mb": 1 },
    "audio": { "extensoes": [".mp3", ".wav", ".m4a", ".ogg", ".flac"], "tamanho_max_mb": 20 },
    "imagem": { "extensoes": [".pdf", ".png", ".jpg", ".jpeg", ".webp"], "tamanho_max_mb": 20 }
  },
  "categorias": [
    "matricula",
    "informacao",
    "solicitacao_documentos",
    "reclamacao",
    "cancelamento"
  ],
  "privacidade": {
    "mascarar_antes_de_enviar": ["cpf", "rg", "email", "telefone"]
  },
  "imagem_institucional": "dados/originais/brasao.png",
  "caminhos": {
    "originais": "dados/originais",
    "gabaritos": "dados/gabaritos",
    "processados": "dados/processados",
    "prompts": "prompts",
    "minutas": "resultados/minutas",
    "audios": "resultados/audios",
    "imagens": "resultados/imagens",
    "experimentos": "resultados/experimentos",
    "logs": "resultados/logs"
  },
  "casos": [
    {
      "id": "texto-01",
      "modalidade": "texto",
      "arquivo": "dados/originais/entrada_texto.txt",
      "gabarito": "dados/gabaritos/texto-01.json"
    },
    {
      "id": "texto-injection",
      "modalidade": "texto",
      "arquivo": "dados/originais/entrada_texto_injection.txt",
      "gabarito": "dados/gabaritos/texto-injection.json"
    },
    {
      "id": "audio-01",
      "modalidade": "audio",
      "arquivo": "dados/originais/entrada_audio.mp3",
      "gabarito": "dados/gabaritos/audio-01.json"
    },
    {
      "id": "imagem-01",
      "modalidade": "imagem",
      "arquivo": "dados/originais/entrada_pdf-imagem.pdf",
      "gabarito": "dados/gabaritos/imagem-01.json"
    }
  ]
}
