{
  "provedor": "openai",
  "modelos": {
    "texto": "gpt-6.1-terra",
    "transcricao": "gpt-transcribe",
    "visao": "gpt-6.1-terra",
    "tts": "gpt-4o-mini-tts",
    "imagem": "gpt-image-2.5-flare",
    "embeddings": "text-embedding-3-small"
  },
  "parametros_geracao": {
    "max_output_tokens": 25000
  },
  "geracao": {
    "perfil_ativo": "principal",
    "perfis": {
      "principal": { "provedor": "openai", "modelo": "gpt-6.1-terra" },
      "alternativo": { "provedor": "openai", "modelo": "gpt-6-luna" }
    }
  },
  "audio": {
    "timeout_inspecao_s": 30,
    "idiomas": ["pt"],
    "voz": "marin",
    "estilo": "Fale em português brasileiro, com tom institucional, claro, sério e acolhedor, em ritmo pausado. Articule nomes, datas e protocolos com clareza. Leia números de protocolo algarismo por algarismo, pronunciando cada zero. Leia somente o texto fornecido, sem comentários ou acréscimos."
  },
  "timeout_segundos": 180,
  "armazenar_no_provedor": false,
  "precos_usd_por_milhao_tokens": {
    "gpt-6.1-terra": { "entrada": 1.0, "saida": 5.0 },
    "gpt-6-luna": { "entrada": 0.1, "saida": 0.5 },
    "text-embedding-3-small": { "entrada": 0.02 },
    "gpt-image-2.5-flare": { "entrada": 5.0, "entrada_imagem": 8.0, "saida": 30.0 }
  },
  "precos_usd_por_minuto_audio": {
    "gpt-transcribe": 0.0045
  },
  "entradas": {
    "texto": { "extensoes": [".txt"], "tamanho_max_mb": 1 },
    "audio": { "extensoes": [".mp3", ".wav", ".m4a", ".ogg", ".flac"], "tamanho_max_mb": 20 },
    "imagem": { "extensoes": [".pdf", ".png", ".jpg", ".jpeg", ".webp"], "tamanho_max_mb": 20 }
  },
  "categorias": [
    "matricula",
    "informacao",
    "solicitacao_documentos",
    "reclamacao",
    "cancelamento",
    "revisao"
  ],
  "privacidade": {
    "mascarar_antes_de_enviar": ["cpf", "rg", "email", "telefone"]
  },
  "acervo": {
    "manifesto": "dados/acervo/acervo.json",
    "extensoes": [".txt", ".pdf"],
    "tamanho_max_mb": 5
  },
  "indice": {
    "colecao": "acervo",
    "top_k": 4,
    "chunking_ativo": "B",
    "chunking": {
      "A": { "unidade": "caracteres", "tamanho": 250, "sobreposicao": 50 },
      "B": { "unidade": "caracteres", "tamanho": 500, "sobreposicao": 100 }
    }
  },
  "limites": {
    "max_caracteres_solicitacao": 8000,
    "max_chamadas_por_execucao": 8,
    "max_tokens_por_execucao": 60000,
    "repeticoes_falha_transitoria": 1
  },
  "sentimentos": {
    "polaridades": ["positiva", "negativa", "neutra", "indeterminada"]
  },
  "imagem_institucional": "dados/originais/brasao.png",
  "caminhos": {
    "originais": "dados/originais",
    "gabaritos": "dados/gabaritos",
    "processados": "dados/processados",
    "prompts": "prompts",
    "minutas": "resultados/minutas",
    "minutas_rag": "resultados/minutas_rag",
    "audios": "resultados/audios",
    "imagens": "resultados/imagens",
    "experimentos": "resultados/experimentos",
    "acervo": "dados/acervo",
    "avaliacoes": "dados/avaliacoes",
    "indice": "indice",
    "metricas": "resultados/metricas",
    "logs": "resultados/logs"
  },
  "casos": [
    {
      "id": "texto-01",
      "modalidade": "texto",
      "arquivo": "dados/originais/entrada_texto.txt",
      "gabarito": "dados/gabaritos/texto-01.json"
    },
    {
      "id": "texto-injection",
      "modalidade": "texto",
      "arquivo": "dados/originais/entrada_texto_injection.txt",
      "gabarito": "dados/gabaritos/texto-injection.json"
    },
    {
      "id": "audio-01",
      "modalidade": "audio",
      "arquivo": "dados/originais/entrada_audio.mp3",
      "gabarito": "dados/gabaritos/audio-01.json"
    },
    {
      "id": "audio-01-ruido",
      "modalidade": "audio",
      "arquivo": "dados/originais/entrada_audio_ruido.mp3",
      "gabarito": "dados/gabaritos/audio-01-ruido.json"
    },
    {
      "id": "imagem-01",
      "modalidade": "imagem",
      "arquivo": "dados/originais/entrada_pdf-imagem.pdf",
      "gabarito": "dados/gabaritos/imagem-01.json"
    }
  ]
}
